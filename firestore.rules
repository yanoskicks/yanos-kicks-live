rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.uid == "vqc5xx018tayOmyxt6BfKkCdVID2";
    }

    match /artifacts/yanos-kicks/users/{userId}/orders/{orderId} {

      // Users: read own orders. Admin: read all orders (for dashboard / collectionGroup).
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);

      // Users may only create their own order as Pending (Paystack webhook updates via Admin SDK).
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.status == "Pending";

      // Only admin may update from the client (e.g. Mark Shipped). Webhook uses Admin SDK (bypasses rules).
      allow update: if isAdmin();

      // No client deletes (use Admin SDK / console if ever needed).
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
