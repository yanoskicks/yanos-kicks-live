rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Yanos Kicks Database Rules
    match /artifacts/yanos-kicks/users/{userId}/orders/{orderId} {
      
      // 1. Users can ONLY read their own orders.
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // 2. Users can ONLY create orders if the status is explicitly set to "Pending". 
      // They cannot create fake "Paid" orders.
      allow create: if request.auth != null 
                    && request.auth.uid == userId 
                    && request.resource.data.status == 'Pending';
      
      // 3. CRITICAL: Users CANNOT update or delete their orders. 
      // Only the secure backend webhook can change a "Pending" order to "Paid".
      allow update, delete: if false; 
    }
    
    // Block access to everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
